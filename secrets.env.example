# Copy to secrets.env (git-ignored) and fill in. Passed into the container by docker compose.

# Headless credential of the agent CLI. For the claude-code adapter, either a long-lived
# token generated once on your machine with `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Fine-grained GitHub token on your own account, scoped to this repo and every target repo:
# Contents (rw), Pull requests (rw), Commit statuses (rw), Actions (r), Metadata (r).
GH_TOKEN=

# Commits are authored as you
GIT_NAME="Your Name"
GIT_EMAIL=you@example.com

# Jira Cloud, your own account. API token from id.atlassian.com -> Security -> API tokens.
JIRA_URL=https://yoursite.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
