# Read by docker compose and bin/agent. Picks the agent CLI adapter in adapters/<name>/.
# To switch agent CLI or LLM provider, add an adapter and change this one line.
AGENT_CLI=claude-code

# UID of the container's `agent` user. Match it to the host user that owns ./workspace,
# otherwise the container can't write to the bind mount (check with `id -u` on the host).
AGENT_UID=1000
